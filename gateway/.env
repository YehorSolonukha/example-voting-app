# .env
# This file stores secrets and environment-specific settings.
# IT SHOULD NEVER BE COMMITTED TO GITHUB (add it to .gitignore).

VOTE_SERVICE_URI=http://vote:80
DB_PASSWORD=super_secret_password_here
# Postgres format: postgres://user:password@host:port/database_name
WAF_DB_URL=postgres://postgres:super_secret_password_here@waf-db:5432/waf_logs
WAF_REDIS_URL=redis://waf-redis:6379
